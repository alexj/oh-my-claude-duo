{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": false,
  "console_title_template": "",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "foreground": "#ffffff",
          "background": "#ff6b35",
          "template": " \uea83 {{ .Path }} ",
          "options": {
            "folder_icon": " \uf07b ",
            "home_icon": "\ue617",
            "style": "folder"
          }
        },
        {
          "background": "#fffb38",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ff9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f26d50{{ end }}",
            "{{ if gt .Ahead 0 }}#f17c37{{ end }}",
            "{{ if gt .Behind 0 }}#89d1dc{{ end }}"
          ],
          "foreground": "#193549",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "type": "text",
          "style": "powerline",
          "leading_powerline_symbol": "\uE0D6",
          "powerline_symbol": "\uE0B0",
          "background": "#00897b",
          "background_templates": [
            "{{ if eq .Env.CLAUDE_CONTEXT_STATE \"danger\" }}#cc2200{{ end }}",
            "{{ if eq .Env.CLAUDE_CONTEXT_STATE \"warning\" }}#e67e00{{ end }}"
          ],
          "foreground": "#ffffff",
          "template": " {{ if .Env.CLAUDE_CONTEXT_PCT }}\u268a <{{ .Env.CLAUDE_CONTEXT_BAR_COLOR }}>{{ .Env.CLAUDE_CONTEXT_BAR_FILLED }}</><#444444>{{ .Env.CLAUDE_CONTEXT_BAR_EMPTY }}</> {{ .Env.CLAUDE_CONTEXT_PCT }}% ({{ .Env.CLAUDE_CONTEXT_REMAINING }}){{ end }} "
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "<transparent,background>\uE0B0</>",
          "trailing_diamond": "\ue0b4",
          "foreground": "#ffffff",
          "background": "#3a86ff",
          "template": " \udb82\udecb {{ .Env.CLAUDE_MODEL }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "background": "transparent",
          "foreground": "#aaaaaa",
          "foreground_templates": [
            "{{ if eq .Env.CLAUDE_PRO_5H_STATE \"danger\" }}#ffffff{{ end }}"
          ],
          "template": "{{ if .Env.CLAUDE_PRO_5H_PCT }}\udb80\udd45 5h: <{{ .Env.CLAUDE_PRO_5H_BAR_COLOR }}>{{ .Env.CLAUDE_PRO_5H_BAR_FILLED }}</><#444444>{{ .Env.CLAUDE_PRO_5H_BAR_EMPTY }}</> {{ .Env.CLAUDE_PRO_5H_PCT }}%{{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "background": "transparent",
          "foreground": "#aaaaaa",
          "foreground_templates": [
            "{{ if eq .Env.CLAUDE_PRO_7D_STATE \"danger\" }}#ffffff{{ end }}"
          ],
          "template": "{{ if .Env.CLAUDE_PRO_7D_PCT }} · 7d: <{{ .Env.CLAUDE_PRO_7D_BAR_COLOR }}>{{ .Env.CLAUDE_PRO_7D_BAR_FILLED }}</><#444444>{{ .Env.CLAUDE_PRO_7D_BAR_EMPTY }}</> {{ .Env.CLAUDE_PRO_7D_PCT }}%{{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "background": "transparent",
          "foreground": "#aaaaaa",
          "template": "{{ if .Env.CLAUDE_RESET_7D_DAY }} · \udb80\udd1b 5h: {{ if eq .Env.CLAUDE_RESET_5H_RESETTING \"true\" }}resetting{{ else }}{{ .Env.CLAUDE_RESET_5H_HOURS }} hours {{ .Env.CLAUDE_RESET_5H_MINS }} minutes{{ end }} · 7d: {{ .Env.CLAUDE_RESET_7D_DAY }} {{ .Env.CLAUDE_RESET_7D_TIME }}{{ end }}"
        }
      ]
    }
  ]
}
